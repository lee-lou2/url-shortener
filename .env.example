RUST_ENV=development
RUST_LOG=info
SERVER_PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortener
DB_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true

# Leave REDIS_HOST blank for L1-only caching.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=0
CACHE_MAX_CAPACITY_BYTES=33554432

# Production requires a random secret of at least 32 bytes. Keep it outside source control.
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST_SIZE=20
# Comma-separated origins. Leave blank for same-origin access.
CORS_ORIGINS=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
