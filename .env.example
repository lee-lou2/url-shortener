RUST_ENV=development
RUST_LOG=info
SERVER_PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortener
DB_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true

# In-process moka TinyLFU cache cap in bytes (default: 32 MiB).
CACHE_MAX_CAPACITY_BYTES=33554432

# Per-IP GCRA rate limit for POST /v1/urls.
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST_SIZE=20

# Comma-separated browser origins allowed for cross-origin POST /v1/urls.
# Leave blank for same-origin browsers + direct non-browser API clients only.
CORS_ORIGINS=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
